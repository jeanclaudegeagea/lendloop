# Copy to n8n/.env (gitignored). docker-compose passes these to n8n.
# Placeholders only; never commit real values.

# Convex HTTP actions URL: the ".convex.site" one, NOT ".convex.cloud".
# Local Convex backend from Docker: http://host.docker.internal:3211
CONVEX_SITE_URL=https://your-deployment-name.convex.site

# HMAC secrets, one per direction. Each must match the same-named Convex env var.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVEX_TO_N8N_SECRET=replace-with-64-hex-chars
N8N_TO_CONVEX_SECRET=replace-with-64-hex-chars

# Encrypts credentials stored in n8n. Set once and keep it: changing it
# makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
