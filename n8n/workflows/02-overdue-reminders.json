            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HMAC write-back": {
      "main": [
        [
          {
            "node": "Record reminder in Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LendLoopErrorWf0"
  },
