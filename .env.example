# Copy to .env.local for Next.js. Placeholders only; never commit real values.

# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# These are NOT read by Next.js. Set them on the Convex deployment instead:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
#   npx convex env set ADMIN_EMAILS you@example.com
#   npx convex env set CONVEX_TO_N8N_SECRET <64 hex chars>
#   npx convex env set N8N_TO_CONVEX_SECRET <64 hex chars, a different value>
#   npx convex env set N8N_WEBHOOK_URL http://localhost:5678/webhook/lendloop-loan-events
# The two secrets must also go in n8n/.env (see n8n/.env.example and README).
# ---------------------------------------------------------------------------
